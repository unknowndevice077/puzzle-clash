# Copy to server/.env for local runs.
NODE_ENV=development
PORT=5070
HOST=0.0.0.0
# Browser origins allowed to call the API in dev (Vite runs on 5174).
CORS_ORIGIN=http://localhost:5174
# Set true behind a proxy (Render, Nginx) so per-IP limits see real client IPs.
TRUST_PROXY=false
# Served over https? Enables HSTS + upgrade-insecure-requests (on automatically in production).
HTTPS=false
DATA_DIR=./data
PHOTOS_DIR=./photos
CLIENT_DIST=../client/dist
MAX_CONN_PER_IP=12
